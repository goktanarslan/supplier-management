{
    "_version": "1.86.0",
    "sap.app": {
        "id": "codeup.supplierapprovals",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "0.0.1"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "dataSources": {
            "mainService": {
                "uri": "/odata/v4/supplier/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        },
        "sourceTemplate": {
            "id": "",
            "version": ""
        },
        "crossNavigation": {
            "inbounds": {
                "Supplier-approve": {
                    "semanticObject": "Supplier",
                    "action": "approve",
                    "title": "{{appTitle}}",
                    "signature": {
                        "parameters": {},
                        "additionalParameters": "allowed"
                    }
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.148.3",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.fe.templates": {},
                "sap.fe.core": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "codeup.supplierapprovals.i18n.i18n"
                }
            },
            "": {
                "dataSource": "mainService",
                "type": "sap.ui.model.odata.v4.ODataModel",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "groupId": "$auto",
                    "synchronizationMode": "None",
                    "autoExpandSelect": true
                }
            }
        },
        "resources": {
            "css": []
        },
        "routing": {
            "config": {},
            "routes": [
                {
                    "name": "ApprovalSuppliersList",
                    "pattern": ":?query:",
                    "target": "ApprovalSuppliersList"
                },
                {
                    "name": "ApprovalSuppliersObjectPage",
                    "pattern": "ApprovalSuppliers({ApprovalSuppliersKey}):?query:",
                    "target": "ApprovalSuppliersObjectPage"
                }
            ],
            "targets": {
                "ApprovalSuppliersList": {
                    "type": "Component",
                    "id": "ApprovalSuppliersList",
                    "name": "sap.fe.templates.ListReport",
                    "options": {
                        "settings": {
                            "contextPath": "/ApprovalSuppliers",
                            "variantManagement": "Page",
                            "initialLoad": true,
                            "views": {
                                "paths": [
                                    {
                                        "key": "All",
                                        "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#All"
                                    },
                                    {
                                        "key": "Pending",
                                        "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Pending"
                                    },
                                    {
                                        "key": "Approved",
                                        "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Approved"
                                    },
                                    {
                                        "key": "Rejected",
                                        "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#Rejected"
                                    }
                                ],
                                "showCounts": true
                            },
                            "controlConfiguration": {
                                "@com.sap.vocabularies.UI.v1.LineItem": {
                                    "tableSettings": {
                                        "type": "ResponsiveTable"
                                    }
                                },
                                "@com.sap.vocabularies.UI.v1.SelectionFields": {
                                    "showClearButton": true
                                }
                            },
                            "navigation": {
                                "ApprovalSuppliers": {
                                    "detail": {
                                        "route": "ApprovalSuppliersObjectPage"
                                    }
                                }
                            }
                        }
                    }
                },
                "ApprovalSuppliersObjectPage": {
                    "type": "Component",
                    "id": "ApprovalSuppliersObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "contextPath": "/ApprovalSuppliers"
                        }
                    }
                }
            }
        }
    }
}
