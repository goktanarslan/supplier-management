{
    "name": "myui5app",
    "version": "0.0.1",
    "description": "myui5app description",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html",
    "dependencies": {},
    "devDependencies": {
        "@ui5/cli": "^4.0.33",
        "@sap/ux-ui5-tooling": "1",
        "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
        "eslint": "^10",
        "@ui5/linter": "latest"
    },
    "scripts": {
        "start": "ui5 serve --config=ui5.yaml --open index.html",
        "build": "ui5 build self-contained --all --include-task generateVersionInfo --config=ui5.yaml --clean-dest --dest ../approuter/dist/myui5app",
        "lint": "eslint ./",
        "ui5lint": "ui5lint",
        "qunit": "fiori run --open test/unitTests.qunit.html",
        "opa5": "fiori run --open test/opaTests.qunit.html"
    },
    "sapux": true
}